# Copy to .env.local (gitignored) and fill in as the weeks land.
# Every new variable added here needs a comment saying what it's for.

# --- Week A (data foundation) ---
# Supabase Postgres connection string. Enable the PostGIS extension in the
# Supabase dashboard before running migrations.
DATABASE_URL=

# --- Week B (AI translation) ---
# Anthropic API key for the default AI provider.
ANTHROPIC_API_KEY=
# Optional: Anthropic model for NL -> SearchQuery translation. Defaults to
# claude-haiku-4-5 (cheap/fast per ADR-001); set claude-opus-4-8 for headroom.
# AI_MODEL=claude-haiku-4-5

# --- Week C (maps) ---
# Google Maps: browser key (referrer-restricted) for the map component,
# server key (API-restricted, quota-capped) for the Geocoding adapter.
# Enable "Maps JavaScript API" (browser key) and "Geocoding API" (server
# key) in the Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=
# Cloud-styled Map ID for Advanced Markers; DEMO_MAP_ID (default) is
# Google's documented placeholder — create a real one before the pitch.
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# --- Week D (cost protection) ---
# Guards in front of every paid model call; defaults shown.
# RATE_LIMIT_PER_MINUTE=10        # per-IP searches per minute
# DAILY_AI_REQUEST_BUDGET=300     # total searches per UTC day, all users

# --- Weeks E-F (provider swaps) ---
# GOOGLE_GENERATIVE_AI_API_KEY=   # Gemini, the second AI provider (Week E)
# AI_PROVIDER=anthropic           # anthropic | google (Week E)
# MAPS_PROVIDER=google            # google | maplibre (Week F)
